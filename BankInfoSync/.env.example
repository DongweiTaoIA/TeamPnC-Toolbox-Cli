# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored. No passwords are stored here — auth is 100% Windows Integrated.

# ODBC driver installed on the machine running the script.
# Common values: "ODBC Driver 17 for SQL Server", "ODBC Driver 18 for SQL Server".
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ---- ACCP (testing) ----
ACCP_SOURCE_SERVER=sql_van_test_accp.iap.iafg.net,49826
ACCP_SOURCE_DB=DPACCP
ACCP_TARGET_SERVER=sy-un_unification.accp.sgbd.ia.iafg.net,45147
ACCP_TARGET_DB=UN_Unification_a
# yes | no  — set to "yes" only if the SQL server uses a self-signed cert.
ACCP_TRUST_SERVER_CERT=YES

# ---- PROD (production) ----
PROD_SOURCE_SERVER=prod-source-server.example.local
PROD_SOURCE_DB=SourceDbName
PROD_TARGET_SERVER=prod-target-server.example.local
PROD_TARGET_DB=TargetDbName
PROD_TRUST_SERVER_CERT=no
