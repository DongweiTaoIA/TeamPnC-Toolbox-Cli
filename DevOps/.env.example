# Copy to .env and fill in. .env is git-ignored. Never commit or paste secrets.

# Azure DevOps PAT with Work Items: Read and Code: Read only.
# Leave empty to use `az login` instead (Azure CLI must be installed).
ADO_PAT=

# PAT for the IFRS board (indall organization), used when DEVOPS_BOARD=ifrs.
# Falls back to ADO_PAT if empty.
ADO_PAT_IFRS=

# Azure OpenAI (company-approved deployment).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Leave empty to sign in with Entra ID (requires `pip install azure-identity`).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
